---
import BaseLayout from "./BaseLayout.astro";
import { getImage } from "astro:assets";
import backgroundSource from "../assets/stranded/itch/background.webp";
import baseSource from "../assets/stranded/itch/base.webp";

const {
  title,
  description,
  image,
  sheetClass = "",
  outerClass = "",
} = Astro.props;

const backgroundImage = await getImage({
  src: backgroundSource,
  width: 1280,
  format: "webp",
  quality: 76,
});
const mobileBackgroundImage = await getImage({
  src: backgroundSource,
  width: 640,
  format: "webp",
  quality: 68,
});
const sheetBorderImage = await getImage({
  src: baseSource,
  format: "webp",
  quality: 90,
});
---

<BaseLayout title={title} description={description} image={image}>
  <Fragment slot="head">
    <link
      rel="preload"
      href={mobileBackgroundImage.src}
      as="image"
      type="image/webp"
      media="(max-width: 640px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      href={backgroundImage.src}
      as="image"
      type="image/webp"
      media="(min-width: 641px)"
      fetchpriority="high"
    />
  </Fragment>
  <div
    style={`--stranded-background-image: url("${backgroundImage.src}"); --stranded-background-image-mobile: url("${mobileBackgroundImage.src}"); --stranded-sheet-border-image: url("${sheetBorderImage.src}");`}
  >
    <div
      class="sheet-page-background fixed inset-0 -z-10 bg-cover bg-center"
    ></div>
    <div class={`mx-auto max-w-[1040px] px-4 font-boogaloo text-[#20231f] sm:px-6 lg:px-10 ${outerClass}`}>
      <div class={`stranded-sheet px-5 py-7 sm:px-10 lg:px-14 ${sheetClass}`}>
        <slot />
      </div>
    </div>
  </div>
  <style>
    .sheet-page-background {
      background-image: var(--stranded-background-image);
    }

    @media (max-width: 640px) {
      .sheet-page-background {
        background-image: var(--stranded-background-image-mobile);
      }
    }
  </style>
</BaseLayout>
